# ZeroDay Arena Environment Configuration Example
# Copy this file to .env and configure your secrets and runtime limits.
# NEVER commit the actual .env file or expose secrets in code or responses.

# ==============================================================================
# AI INFERENCE & THREAT INTELLIGENCE (NVIDIA Nemotron via Nebius + Tavily)
# ==============================================================================

# AI Inference Provider: Nebius Token Factory (NVIDIA Nemotron)
LLM_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Threat Intelligence Search Provider: Tavily
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Rate Limits (Server-side enforced)
PER_DEVICE_RATE_LIMIT=5
PER_DEVICE_RATE_WINDOW_SECONDS=3600
GLOBAL_RATE_LIMIT=20
GLOBAL_RATE_WINDOW_SECONDS=3600

# Timeouts (in seconds)
ANALYSIS_TIMEOUT_SECONDS=600
TEST_EXECUTION_TIMEOUT_SECONDS=30

# Resource & Concurrency Boundaries
MAX_REPOSITORY_SIZE_MB=10
MAX_CONCURRENT_ANALYSES=2

# FinOps Budget Protection (USD)
NEBIUS_BUDGET_USD=59.50
NEBIUS_BUDGET_SAFETY_THRESHOLD=0.90

# Token Optimization & Caching
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
CACHE_DIR=.cache


# ==============================================================================
# PRODUCTION ORIGIN & SEO METADATA
# ==============================================================================
# Set your production origin (e.g. https://zeroday.dev or https://your-domain.com)
# Used for absolute Open Graph social sharing image and canonical URLs.
VITE_SITE_URL=https://zeroday.dev
